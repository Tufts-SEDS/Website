{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "tuftsseds/static/**"
      }
    },
    {
      "src": "tuftsseds/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*\\.(?:webp|png|jpe?g|gif|ico|svg|woff2?|ttf|eot|pdf))",
      "headers": {
        "Cache-Control": "public, max-age=2592000, stale-while-revalidate=86400"
      },
      "dest": "/tuftsseds/static/$1"
    },
    {
      "src": "/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "dest": "/tuftsseds/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
